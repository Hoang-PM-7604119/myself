---
import site from '@/data/site.yaml';
import profile from '@/data/profile.yaml';
import social from '@/data/social.yaml';
import theme from '@/data/theme.yaml';
import '@/styles/global.css';
interface Props { title?: string; description?: string; image?: string; article?: Record<string, unknown>; progress?: boolean; }
const defaultImage = '/images/og-thumbnail.svg';
const { title, description = site.description, image = defaultImage, article, progress = false } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const asset = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const absoluteImage = new URL(asset(image), Astro.site);
const personLd = { '@context':'https://schema.org', '@type':'Person', name:profile.name, jobTitle:profile.role, affiliation:{'@type':'Organization',name:profile.institution}, email:`mailto:${profile.email}`, url:canonical.origin + import.meta.env.BASE_URL, sameAs:Object.values(social) };
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizePath = (path: string) => {
  const withBase = `${basePath}/${path.replace(/^\//, '')}`;
  return withBase.endsWith('/') ? withBase : `${withBase}/`;
};
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<!doctype html>
<html lang={site.language} data-theme="light" style={`--accentLight:${theme.accent};--accentDark:${theme.accentDark};--radius:${theme.radius};--motion:${theme.motion}`}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <title>{pageTitle}</title><meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
  <link rel="apple-touch-icon" href={asset('/favicon.svg')} />
  <link rel="canonical" href={canonical} /><link rel="alternate" type="application/rss+xml" title={`${site.name} news`} href={asset('/rss.xml')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&family=Newsreader:opsz,wght@6..72,450;6..72,560;6..72,650&family=Spline+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={absoluteImage} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="theme-color" content={theme.accent} />
  <script type="application/ld+json" set:html={JSON.stringify(article ?? personLd)} />
  <style define:vars={{ accent: theme.accent, accentDark: theme.accentDark, radius: theme.radius, motion: theme.motion }}></style>
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      document.documentElement.dataset.theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.lang = localStorage.getItem('lang') || 'en';
    } catch {
      document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.lang = 'en';
    }
  </script>
</head>
<body data-progress={progress}>
  {progress && <div class="reading-progress" aria-hidden="true"><span></span></div>}
  <a class="skip" href="#main"><span data-i18n-en>Skip to content</span><span data-i18n-vi>Chuyển đến nội dung</span></a>
  <header class="site-header">
    <a class="brand" href={asset('/')}><span>MH</span><strong>{profile.name}</strong></a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav"><span class="sr-only">Toggle navigation</span>Menu</button>
    <nav id="site-nav" aria-label="Primary"><ul>{site.navigation.map((item) => {
      const href = asset(item.href);
      const normalized = normalizePath(item.href);
      const isCurrent = currentPath === normalized || (normalized !== normalizePath('/') && currentPath.startsWith(normalized));
      return <li><a href={href} aria-current={isCurrent ? 'page' : undefined}><span data-i18n-en>{item.label}</span><span data-i18n-vi>{item.label_vi || item.label}</span></a></li>;
    })}</ul></nav>
    <button class="lang-toggle" aria-label="Switch language / Đổi ngôn ngữ" title="Switch language (EN / VI)"><span class="lang-opt" data-lang-val="en">EN</span><span class="lang-sep">|</span><span class="lang-opt" data-lang-val="vi">VI</span></button>
    <button class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
  </header>
  <main id="main"><slot /></main>
  <footer><div><strong>{profile.name}</strong><p><span data-i18n-en>AIoT, environmental monitoring, computer vision, edge AI, and deployable intelligent sensing platforms.</span><span data-i18n-vi>Hệ thống AIoT, giám sát môi trường, thị giác máy tính, Edge AI và các nền tảng cảm biến thông minh.</span></p></div><div><a href={asset('/contact/')}><span data-i18n-en>Contact</span><span data-i18n-vi>Liên hệ</span></a><a href={asset('/rss.xml')}>RSS</a><a href={social.github}>GitHub</a></div><small>© {new Date().getFullYear()} {profile.name}. <span data-i18n-en>Built as a static Astro site.</span><span data-i18n-vi>Phát triển trên nền tảng tĩnh Astro.</span></small></footer>
  <script>
    const root=document.documentElement;
    document.querySelector('.theme-toggle')?.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('theme',next)}catch{}});
    document.querySelector('.lang-toggle')?.addEventListener('click',()=>{const next=root.dataset.lang==='vi'?'en':'vi';root.dataset.lang=next;try{localStorage.setItem('lang',next)}catch{}});
    const navButton=document.querySelector<HTMLButtonElement>('.nav-toggle');navButton?.addEventListener('click',()=>navButton.setAttribute('aria-expanded',String(navButton.getAttribute('aria-expanded')!=='true')));
    document.querySelectorAll('.hero[data-reveal], .hero [data-reveal-stagger]').forEach((el) => el.classList.add('revealed'));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });
    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => observer.observe(el));

    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy || '');
      const old = button.textContent;
      button.textContent = 'Copied';
      setTimeout(() => button.textContent = old, 1600);
    }));

    if (document.body.dataset.progress === 'true') {
      const bar = document.querySelector<HTMLElement>('.reading-progress span');
      const updateProgress = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const progress = total > 0 ? Math.min(Math.max(window.scrollY / total, 0), 1) : 0;
        if (bar) bar.style.transform = `scaleX(${progress})`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }
  </script>
</body></html>
