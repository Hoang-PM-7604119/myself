---
import BaseLayout from './BaseLayout.astro';
import { wordsToMinutes, pretty } from '@/lib/content';
interface Props { title: string; description: string; date?: Date; topics?: string[]; prose?: string; type?: 'CreativeWork'|'ScholarlyArticle'; }
const { title, description, date, topics = [], prose = '', type = 'CreativeWork' } = Astro.props;
const headings = Array.from(prose.matchAll(/^##\s+(.+)$/gm)).map(m => ({ text:m[1], id:m[1].toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'') }));
const ld = { '@context':'https://schema.org', '@type':type, headline:title, description, datePublished:date?.toISOString(), author:{'@type':'Person',name:'Dr. Maya Chen'} };
---
<BaseLayout title={title} description={description} article={ld} progress>
  <article class="content-shell">
    <header class="article-head"><p class="eyebrow">Research record</p><h1>{title}</h1><p class="lede">{description}</p><div class="meta">{date && <time datetime={date.toISOString()}>{date.toLocaleDateString('en',{year:'numeric',month:'long',day:'numeric'})}</time>}<span>{wordsToMinutes(prose)} min read</span></div><div class="tags">{topics.map(t=><a href={`${import.meta.env.BASE_URL}topics/${t}/`}>{pretty(t)}</a>)}</div></header>
    <div class="article-grid">{headings.length > 1 && <aside class="toc" aria-label="Table of contents"><strong>On this page</strong><ol>{headings.map(h=><li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol></aside>}<div class="prose"><slot /></div></div>
  </article>
</BaseLayout>
