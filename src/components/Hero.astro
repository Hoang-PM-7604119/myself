---
import profile from '@/data/profile.yaml'; import social from '@/data/social.yaml'; import research from '@/data/research.yaml';
const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section class="hero" aria-labelledby="hero-title"><div><p class="eyebrow">Computer engineering · embedded intelligence</p><p class="role">{profile.role} / {profile.institution}</p><h1 id="hero-title">Useful intelligence, <em>closer to the world.</em></h1><p class="lede">{profile.statement}</p><div class="tags">{research.map(r=><a href={asset(`/topics/${r.slug}/`)}>{r.title}</a>)}</div><div class="actions"><a class="button primary" href={asset('/projects/')}>View projects</a><a class="button" href={asset('/publications/')}>Publications</a><a class="button" href={asset(profile.cv)} download>Download CV</a></div><div class="socials"><a href={`mailto:${profile.email}`}>Email</a><a href={social.github}>GitHub</a><a href={social.scholar}>Scholar</a><a href={social.orcid}>ORCID</a><a href={social.linkedin}>LinkedIn</a></div></div><div class="hero-visual"><img src={asset(profile.image)} width="720" height="840" alt={`Fictional portrait of ${profile.name}`} /></div></section>
