---
import profile from '@/data/profile.yaml'; import social from '@/data/social.yaml'; import research from '@/data/research.yaml';
const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section class="hero" aria-labelledby="hero-title" data-reveal>
  <div class="hero-copy" data-reveal-stagger>
    <p class="role"><span data-i18n-en>{profile.role} / {profile.institution}</span><span data-i18n-vi>{profile.role_vi || profile.role} / {profile.institution_vi || profile.institution}</span></p>
    <h1 id="hero-title"><span data-i18n-en>Field AIoT systems, <em>from sensors to intelligence.</em></span><span data-i18n-vi>Hệ thống AIoT thực địa, <em>từ cảm biến đến trí tuệ nhân tạo.</em></span></h1>
    <p class="lede"><span data-i18n-en>{profile.statement}</span><span data-i18n-vi>{profile.statement_vi || profile.statement}</span></p>
    <div class="signal-strip" aria-label="Core system stack">
      <span><i class="signal-pulse" aria-hidden="true"></i> <span data-i18n-en>embedded nodes</span><span data-i18n-vi>nút nhúng</span></span>
      <span><i class="signal-pulse" aria-hidden="true"></i> <span data-i18n-en>computer vision</span><span data-i18n-vi>thị giác máy tính</span></span>
      <span><i class="signal-pulse" aria-hidden="true"></i> <span data-i18n-en>edge AI</span><span data-i18n-vi>trí tuệ nhân tạo biên</span></span>
      <span><i class="signal-pulse" aria-hidden="true"></i> <span data-i18n-en>cloud infrastructure</span><span data-i18n-vi>hạ tầng đám mây</span></span>
    </div>
    <div class="tags">{research.map(r => <a href={asset(`/topics/${r.slug}/`)}><span data-i18n-en>{r.title}</span><span data-i18n-vi>{r.title_vi || r.title}</span></a>)}</div>
    <div class="actions">
      <a class="button primary" href={asset('/projects/')}><span data-i18n-en>Explore field systems &rarr;</span><span data-i18n-vi>Khám phá hệ thống thực địa &rarr;</span></a>
      <a class="button" href={asset('/publications/')}><span data-i18n-en>Publications</span><span data-i18n-vi>Công bố khoa học</span></a>
      <a class="button" href={asset('/cv/')}><span data-i18n-en>Academic CV</span><span data-i18n-vi>Lý lịch khoa học</span></a>
    </div>
    <div class="socials">
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={social.github}>GitHub</a>
      <a href={social.scholar}>Scholar</a>
      <a href={social.linkedin}>LinkedIn</a>
    </div>
  </div>
  <div class="hero-visual" aria-label="Field AIoT System Visual">
    <div class="hero-frame">
      <picture>
        <source srcset={`${asset('/images/profile/minh-hoang-pham-mobile.webp')} 420w, ${asset('/images/profile/minh-hoang-pham.webp')} 800w`} sizes="(max-width: 640px) 380px, 720px" type="image/webp" />
        <img src={asset(profile.image)} width="720" height="840" alt={`System diagram and profile mark for ${profile.name}`} fetchpriority="high" decoding="async" />
      </picture>
      <div class="hero-telemetry-badge" aria-hidden="true">
        <span class="telemetry-live-dot"></span>
        <span class="telemetry-text">FIELD / SENSOR / MODEL / CLOUD</span>
        <span class="telemetry-code">SYS_ONLINE</span>
      </div>
    </div>
  </div>
</section>
