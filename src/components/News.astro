---
import { published, pretty } from '@/lib/content'; const news=(await published('news')).slice(0,3); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><p class="eyebrow">Lab notes</p><h2>Recent academic updates</h2></div><a href={asset('/news/')}>News archive →</a></div><div class="news-list">{news.map(n=><article class="news-row"><time>{n.data.date.toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric'})}</time><a href={asset(`/news/${n.id}/`)}>{n.data.title}</a><span class="eyebrow">{pretty(n.data.category)}</span></article>)}</div></section>
