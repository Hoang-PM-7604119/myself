---
import { published, pretty } from '@/lib/content'; const news=(await published('news')).slice(0,3); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><p class="eyebrow"><span data-i18n-en>Lab notes</span><span data-i18n-vi>Ghi chép & Tin tức</span></p><h2><span data-i18n-en>Recent academic updates</span><span data-i18n-vi>Cập nhật học thuật mới nhất</span></h2></div><a href={asset('/news/')}><span data-i18n-en>News archive →</span><span data-i18n-vi>Kho lưu trữ tin tức →</span></a></div><div class="news-list" data-reveal-stagger>{news.map(n=><article class="news-row"><time>{n.data.date.toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric'})}</time><a href={asset(`/news/${n.id}/`)}><span data-i18n-en>{n.data.title}</span><span data-i18n-vi>{n.data.title_vi || n.data.title}</span></a><span class="eyebrow"><span data-i18n-en>{pretty(n.data.category)}</span><span data-i18n-vi>{n.data.category === 'publication' ? 'Công bố' : (n.data.category === 'project' ? 'Dự án' : (n.data.category === 'award' ? 'Giải thưởng' : 'Chung'))}</span></span></article>)}</div></section>

