---
import { published } from '@/lib/content'; const people=(await published('people')).filter(p=>p.data.featured); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><p class="eyebrow">People & collaborations</p><h2>No project is a solo journey</h2></div><a href={asset('/people/')}>Meet the community →</a></div><div class="people-grid">{people.map(p=><article class="person"><a href={asset(`/people/${p.id}/`)}><img src={asset(p.data.image)} width="400" height="400" loading="lazy" alt="" /></a><div><h3><a href={asset(`/people/${p.id}/`)}>{p.data.title}</a></h3><small>{p.data.role}</small><p>{p.data.description}</p></div></article>)}</div></section>
