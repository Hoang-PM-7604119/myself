---
import { published } from '@/lib/content'; const people=(await published('people')).filter(p=>p.data.featured); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><p class="eyebrow"><span data-i18n-en>People & collaborations</span><span data-i18n-vi>Đội ngũ & Cộng sự</span></p><h2><span data-i18n-en>No project is a solo journey</span><span data-i18n-vi>Mỗi dự án là một hành trình kết nối</span></h2></div><a href={asset('/people/')}><span data-i18n-en>Meet the community →</span><span data-i18n-vi>Gặp gỡ tất cả cộng sự →</span></a></div><div class="people-grid">{people.map(p=><article class="person"><a href={asset(`/people/${p.id}/`)}><img src={asset(p.data.image)} width="400" height="400" loading="lazy" alt="" /></a><div><h3><a href={asset(`/people/${p.id}/`)}>{p.data.title}</a></h3><small>{p.data.role_vi ? <><span data-i18n-en>{p.data.role}</span><span data-i18n-vi>{p.data.role_vi}</span></> : p.data.role}</small><p><span data-i18n-en>{p.data.description}</span><span data-i18n-vi>{p.data.description_vi || p.data.description}</span></p></div></article>)}</div></section>

