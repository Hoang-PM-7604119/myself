---
import research from '@/data/research.yaml';

const asset = (p: string) => `${import.meta.env.BASE_URL}${p.replace(/^\//, '')}`;
---
<section data-reveal>
  <div class="section-head">
    <div>
      <h2><span data-i18n-en>Research and engineering focus</span><span data-i18n-vi>Trọng tâm nghiên cứu & kỹ thuật</span></h2>
    </div>
    <p>
      <span data-i18n-en>My work sits where academic questions become deployed systems: sensing hardware, AI models, backend infrastructure, and field operations have to be designed together.</span>
      <span data-i18n-vi>Nghiên cứu của tôi biến các bài toán khoa học thành hệ thống thực địa: phần cứng cảm biến, mô hình AI, hạ tầng backend và triển khai thực địa được thiết kế đồng bộ.</span>
    </p>
  </div>
  <div class="research-grid" data-reveal-stagger>
    {research.map((r) => (
      <article class="research-card">
        <h3><a href={asset(`/topics/${r.slug}/`)}><span data-i18n-en>{r.title}</span><span data-i18n-vi>{r.title_vi || r.title}</span></a></h3>
        <p><span data-i18n-en>{r.summary}</span><span data-i18n-vi>{r.summary_vi || r.summary}</span></p>
      </article>
    ))}
  </div>
</section>
