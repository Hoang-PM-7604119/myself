---
import { published, pretty } from '@/lib/content'; const items=(await published('publications')).filter(p=>p.data.featured).slice(0,3); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><h2><span data-i18n-en>Selected publications</span><span data-i18n-vi>Công bố khoa học tiêu biểu</span></h2></div><a href={asset('/publications/')}><span data-i18n-en>Full publication record</span><span data-i18n-vi>Tất cả công bố khoa học</span></a></div><div class="publication-list" data-reveal-stagger>{items.map(p=><article class="publication"><div class="year">{p.data.year}<br/><span class="tag"><span data-i18n-en>{pretty(p.data.type)}</span><span data-i18n-vi>{p.data.type === 'journal' ? 'Tạp chí' : (p.data.type === 'conference' ? 'Hội nghị' : pretty(p.data.type))}</span></span></div><div><h3><a class="publication-title" href={asset(`/publications/${p.id}/`)}><span data-i18n-en>{p.data.title}</span><span data-i18n-vi>{p.data.title_vi || p.data.title}</span></a></h3><p class="authors">{p.data.authors.map(a=>a.name).join(', ')}</p><p><span data-i18n-en>{p.data.summary}</span><span data-i18n-vi>{p.data.summary_vi || p.data.summary}</span></p><p class="eyebrow">{p.data.venue} / <span data-i18n-en>{pretty(p.data.status)}</span><span data-i18n-vi>{p.data.status === 'published' ? 'Đã xuất bản' : (p.data.status === 'accepted' ? 'Đã chấp nhận' : pretty(p.data.status))}</span></p></div></article>)}</div></section>

