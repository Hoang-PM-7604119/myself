---
import { published, pretty } from '@/lib/content'; const items=(await published('publications')).filter(p=>p.data.featured).slice(0,3); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><h2><span data-i18n-en>Selected publications</span><span data-i18n-vi>Công bố khoa học tiêu biểu</span></h2></div><a href={asset('/publications/')}><span data-i18n-en>Full publication record</span><span data-i18n-vi>Tất cả công bố khoa học</span></a></div><div class="publication-list">{items.map(p=><article class="publication"><div class="year">{p.data.year}<br/><span class="tag">{pretty(p.data.type)}</span></div><div><h3><a class="publication-title" href={asset(`/publications/${p.id}/`)}>{p.data.title}</a></h3><p class="authors">{p.data.authors.map(a=>a.name).join(', ')}</p><p>{p.data.summary}</p><p class="eyebrow">{p.data.venue} / {pretty(p.data.status)}</p></div></article>)}</div></section>
