---
import experience from '@/data/experience.yaml'; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><h2><span data-i18n-en>Academic and technical journey</span><span data-i18n-vi>Hành trình học thuật & kỹ thuật</span></h2></div><a href={asset('/experience/')}><span data-i18n-en>Complete experience &rarr;</span><span data-i18n-vi>Toàn bộ quá trình công tác &rarr;</span></a></div><div class="timeline">{experience.map(e=><article class="timeline-item"><span class="date">{e.start} - {e.present?'present':e.end}</span><h3>{e.role}</h3><strong>{e.organization}</strong><p>{e.summary}</p></article>)}</div></section>
