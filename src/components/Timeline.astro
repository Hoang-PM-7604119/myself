---
import experience from '@/data/experience.yaml'; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><h2>Academic and technical journey</h2></div><a href={asset('/experience/')}>Complete experience</a></div><div class="timeline">{experience.map(e=><article class="timeline-item"><span class="date">{e.start} - {e.present?'present':e.end}</span><h3>{e.role}</h3><strong>{e.organization}</strong><p>{e.summary}</p></article>)}</div></section>
