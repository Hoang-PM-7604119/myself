---
import experience from '@/data/experience.yaml'; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><h2><span data-i18n-en>Academic and technical journey</span><span data-i18n-vi>Hành trình học thuật & kỹ thuật</span></h2></div><a href={asset('/experience/')}><span data-i18n-en>Complete experience &rarr;</span><span data-i18n-vi>Toàn bộ quá trình công tác &rarr;</span></a></div><div class="timeline" data-reveal-stagger>{experience.map(e=><article class="timeline-item"><span class="date">{e.start} - {e.present ? <><span data-i18n-en>present</span><span data-i18n-vi>hiện tại</span></> : e.end}</span><h3><span data-i18n-en>{e.role}</span><span data-i18n-vi>{e.role_vi || e.role}</span></h3><strong><span data-i18n-en>{e.organization}</span><span data-i18n-vi>{e.organization_vi || e.organization}</span></strong><p><span data-i18n-en>{e.summary}</span><span data-i18n-vi>{e.summary_vi || e.summary}</span></p></article>)}</div></section>

