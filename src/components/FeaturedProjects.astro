---
import { published } from '@/lib/content'; const projects=(await published('projects')).filter(p=>p.data.featured).slice(0,3); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="section-head"><div><h2>Deployed research systems</h2></div><a href={asset('/projects/')}>Explore all projects</a></div><div class="cards">{projects.map(p=><article class="card"><a href={asset(`/projects/${p.id}/`)}><img src={asset(p.data.cover)} width="1200" height="720" loading="lazy" alt="" /></a><div class="card-body"><p class="eyebrow">{p.data.status} / {p.data.start}-{p.data.end??'present'}</p><h3><a class="stretched" href={asset(`/projects/${p.id}/`)}>{p.data.title}</a></h3><p>{p.data.description}</p><div class="tags">{p.data.technologies.slice(0,4).map(t=><span class="tag">{t}</span>)}</div></div></article>)}</div></section>
