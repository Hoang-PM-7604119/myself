---
import profile from '@/data/profile.yaml'; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<section data-reveal><div class="cta"><div><p class="eyebrow">Start a conversation</p><h2>Have a hard systems problem with a real-world edge?</h2></div><div class="actions"><a class="button" href={`mailto:${profile.email}`}>Email Maya</a><a class="button" href={asset('/contact/')}>Contact details</a></div></div></section>
