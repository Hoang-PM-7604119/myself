---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { published } from '@/lib/content'; const talks=await published('talks'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="Talks" description="Invited talks, seminars, and research presentations."><div class="page"><p class="eyebrow"><span data-i18n-en>Talks</span><span data-i18n-vi>Bài nói chuyện & Hội thảo</span></p><h1><span data-i18n-en>Ideas in conversation.</span><span data-i18n-vi>Trao đổi & Chia sẻ ý tưởng khoa học.</span></h1><div class="publication-list" style="margin-top:50px">{talks.map(t=><article class="publication"><time class="year">{t.data.date.getFullYear()}</time><div><h2><span data-i18n-en>{t.data.title}</span><span data-i18n-vi>{t.data.title_vi || t.data.title}</span></h2><p><span data-i18n-en>{t.data.description}</span><span data-i18n-vi>{t.data.description_vi || t.data.description}</span></p><p class="eyebrow">{t.data.venue} · {t.data.location}</p><div class="resource-links">{t.data.slides&&<a href={asset(t.data.slides)}><span data-i18n-en>Slides</span><span data-i18n-vi>Tài liệu</span></a>}{t.data.video&&<a href={t.data.video}>Video</a>}</div></div></article>)}</div></div></BaseLayout>

