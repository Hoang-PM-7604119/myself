---
import { render, type CollectionEntry } from 'astro:content'; import ContentLayout from '@/layouts/ContentLayout.astro'; import { published } from '@/lib/content';
export async function getStaticPaths(){return (await published('news')).map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props as {entry:CollectionEntry<'news'>}; const {Content}=await render(entry);
---
<ContentLayout title={entry.data.title} title_vi={entry.data.title_vi} description={entry.data.description} description_vi={entry.data.description_vi} date={entry.data.date} topics={entry.data.topics} prose={entry.body}><Content/></ContentLayout>

