---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { published, pretty } from '@/lib/content'; const news=await published('news'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="News" description="Recent research news, publications, projects, awards, and field notes."><div class="page"><p class="eyebrow"><span data-i18n-en>News archive</span><span data-i18n-vi>Kho lưu trữ tin tức</span></p><h1><span data-i18n-en>Updates from the research journey.</span><span data-i18n-vi>Những cập nhật mới nhất từ hành trình nghiên cứu.</span></h1><div class="news-list" style="margin-top:50px">{news.map(n=><article class="news-row"><time>{n.data.date.toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric'})}</time><div><a href={asset(`/news/${n.id}/`)}><span data-i18n-en>{n.data.title}</span><span data-i18n-vi>{n.data.title_vi || n.data.title}</span></a><p><span data-i18n-en>{n.data.description}</span><span data-i18n-vi>{n.data.description_vi || n.data.description}</span></p></div><span class="eyebrow">{pretty(n.data.category)}</span></article>)}</div></div></BaseLayout>

