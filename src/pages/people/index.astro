---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { published } from '@/lib/content'; const people=await published('people'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="People" description="Collaborators, mentors, and people met during the research journey."><div class="page"><p class="eyebrow"><span data-i18n-en>Research community</span><span data-i18n-vi>Cộng đồng nghiên cứu</span></p><h1><span data-i18n-en>The people who changed the questions.</span><span data-i18n-vi>Những người định hình nên các câu hỏi nghiên cứu.</span></h1><p class="lede"><span data-i18n-en>Collaboration is not metadata. These short notes record what each relationship brought to the work.</span><span data-i18n-vi>Hợp tác không chỉ là thông tin đi kèm. Đây là những ghi nhận trân trọng về sự đóng góp và gắn kết của từng đồng nghiệp trong suốt hành trình.</span></p><div class="people-grid" style="margin-top:50px">{people.map(p=><article class="person"><a href={asset(`/people/${p.id}/`)}><img src={asset(p.data.image)} width="400" height="400" alt=""/></a><div><h3><a href={asset(`/people/${p.id}/`)}>{p.data.title}</a></h3><small>{p.data.role} · {p.data.organization}</small><p>{p.data.description}</p></div></article>)}</div></div></BaseLayout>
