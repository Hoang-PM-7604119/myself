---
import { render, type CollectionEntry } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import { published, pretty, wordsToMinutes } from '@/lib/content';
import ProjectPartnerMarquee from '@/components/ProjectPartnerMarquee.astro';
import { getProjectPartners } from '@/data/partners';
export async function getStaticPaths(){return (await published('projects')).map((entry)=>({params:{slug:entry.id},props:{entry}}))}
const { entry }=Astro.props as {entry:CollectionEntry<'projects'>}; const {Content,headings,remarkPluginFrontmatter}=await render(entry); const all=await published('projects'); const people=await published('people'); const pubs=await published('publications'); const idx=all.findIndex(p=>p.id===entry.id); const previous=all[idx-1],next=all[idx+1]; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
const prose=remarkPluginFrontmatter?.minutes?String(remarkPluginFrontmatter.minutes):entry.body??''; const ld={'@context':'https://schema.org','@type':'CreativeWork',name:entry.data.title,description:entry.data.description,dateCreated:entry.data.date.toISOString()};
const rawH2 = Array.from((entry.body || '').matchAll(/^##\s+(.+)$/gm)).map(m => m[1]);
const projectPeople = entry.data.people.map(id => people.find(p => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const relatedPubs = pubs.filter(p=>entry.data.publications.includes(p.id)||p.data.projects.includes(entry.id));
const projectPartnersList = getProjectPartners(entry.id);
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.cover} article={ld} progress><article class="content-shell"><header class="article-head"><p class="eyebrow"><span data-i18n-en>Project story · {pretty(entry.data.status)}</span><span data-i18n-vi>Hồ sơ dự án · {entry.data.status === 'active' ? 'Đang thực hiện' : (entry.data.status === 'completed' ? 'Hoàn thành' : 'Tạm dừng')}</span></p><h1><span data-i18n-en>{entry.data.title}</span><span data-i18n-vi>{entry.data.title_vi || entry.data.title}</span></h1><p class="lede"><span data-i18n-en>{entry.data.description}</span><span data-i18n-vi>{entry.data.description_vi || entry.data.description}</span></p><img class="project-cover" src={asset(entry.data.cover)} width="1200" height="720" alt=""/><dl class="project-meta"><div><dt><span data-i18n-en>Timeline</span><span data-i18n-vi>Thời gian</span></dt><dd>{entry.data.start}—{entry.data.end ?? <><span data-i18n-en>present</span><span data-i18n-vi>hiện tại</span></>}</dd></div><div><dt><span data-i18n-en>Reading time</span><span data-i18n-vi>Thời lượng</span></dt><dd>{wordsToMinutes(prose)} <span data-i18n-en>min</span><span data-i18n-vi>phút</span></dd></div><div><dt><span data-i18n-en>Partners</span><span data-i18n-vi>Đối tác</span></dt><dd>{projectPartnersList.length || entry.data.organizations.length}</dd></div><div><dt><span data-i18n-en>Collaborators</span><span data-i18n-vi>Thành viên</span></dt><dd>{entry.data.people.length}</dd></div><div><dt><span data-i18n-en>Technologies</span><span data-i18n-vi>Công nghệ</span></dt><dd>{entry.data.technologies.length}</dd></div></dl><div class="tags">{entry.data.topics.map(t=><a href={asset(`/topics/${t}/`)}>{pretty(t)}</a>)}</div><ProjectPartnerMarquee projectId={entry.id} /></header><div class="article-grid"><aside class="toc"><strong><span data-i18n-en>On this page</span><span data-i18n-vi>Mục lục trang</span></strong><ol>{headings.filter(h=>h.depth===2).map((h, idx)=><li><a href={`#${h.slug}`} set:html={rawH2[idx] || h.text} /></li>)}</ol><div class="resource-links">{entry.data.code&&<a href={entry.data.code}>Code ↗</a>}{entry.data.dataset&&<a href={entry.data.dataset}>Dataset ↗</a>}{entry.data.video&&<a href={entry.data.video} target="_blank" rel="noopener">Video ↗</a>}</div></aside><div class="prose"><Content/>{projectPartnersList.length > 0 ? (<><h2><span data-i18n-en>Partners & Research Institutions</span><span data-i18n-vi>Đối tác & Viện nghiên cứu</span></h2><div class="partners-org-grid">{projectPartnersList.map((partner) => (<a href={partner.url || '#'} class="partner-org-card" target={partner.url ? '_blank' : undefined} rel={partner.url ? 'noopener noreferrer' : undefined}><span class="partner-org-badge"><img src={asset(partner.logo)} alt={`${partner.shortNameEn} logo`} width="44" height="44" loading="lazy" decoding="async"/></span><div class="partner-org-content"><strong class="partner-org-name"><span data-i18n-en>{partner.nameEn}</span><span data-i18n-vi>{partner.nameVi}</span></strong><span class="partner-org-action"><span data-i18n-en>{partner.shortNameEn} · Official Portal &nearr;</span><span data-i18n-vi>{partner.shortNameVi} · Cổng thông tin &nearr;</span></span></div></a>))}</div></>) : (entry.data.organizations.length > 0 && <h2><span data-i18n-en>Partners & Research Institutions</span><span data-i18n-vi>Đối tác & Viện nghiên cứu</span></h2><ul>{entry.data.organizations.map(org => <li><strong>{org}</strong></li>)}</ul>)}<h2><span data-i18n-en>People involved</span><span data-i18n-vi>Thành viên tham gia</span></h2><div class="people-grid">{projectPeople.map(p=><article class="person"><img src={asset(p.data.image)} width="400" height="400" alt=""/><div><h3><a href={asset(`/people/${p.id}/`)}>{p.data.title}</a></h3><small>{p.data.role_vi ? <><span data-i18n-en>{p.data.role}</span><span data-i18n-vi>{p.data.role_vi}</span></> : p.data.role}</small></div></article>)}</div>{relatedPubs.length > 0 && <><h2><span data-i18n-en>Related publications</span><span data-i18n-vi>Công bố khoa học liên quan</span></h2>{relatedPubs.map(p=><p><a href={asset(`/publications/${p.id}/`)}><span data-i18n-en>{p.data.title}</span><span data-i18n-vi>{p.data.title_vi || p.data.title}</span></a></p>)}</>}<nav class="pagination">{previous?<a href={asset(`/projects/${previous.id}/`)}>← <span data-i18n-en>{previous.data.title}</span><span data-i18n-vi>{previous.data.title_vi || previous.data.title}</span></a>:<span/>}{next&&<a href={asset(`/projects/${next.id}/`)}><span data-i18n-en>{next.data.title}</span><span data-i18n-vi>{next.data.title_vi || next.data.title}</span> →</a>}</nav></div></div></article></BaseLayout>

<style>
  .partners-org-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    margin: 18px 0 32px;
  }

  .partner-org-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-radius: var(--radius-lg);
    background: var(--surface-glass);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--line);
    box-shadow: var(--glass-bevel);
    text-decoration: none;
    color: var(--ink);
    transition: transform var(--duration-fast) var(--ease-apple),
                background-color var(--duration-fast) ease,
                border-color var(--duration-fast) ease,
                box-shadow var(--duration-fast) ease;
  }

  .partner-org-card:hover {
    transform: translateY(-2px);
    background: var(--surfaceSolid);
    border-color: color-mix(in srgb, var(--accent), var(--line) 40%);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35), var(--glass-bevel);
  }

  .partner-org-badge {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #ffffff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    overflow: hidden;
    padding: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2), inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .partner-org-badge img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    display: block;
  }

  .partner-org-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .partner-org-name {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .partner-org-card:hover .partner-org-name {
    color: var(--accent);
  }

  .partner-org-action {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .partner-org-card:hover .partner-org-action {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .partners-org-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .partner-org-card {
      padding: 10px 12px;
      gap: 10px;
    }

    .partner-org-badge {
      width: 40px;
      height: 40px;
    }

    .partner-org-badge img {
      width: 30px;
      height: 30px;
    }

    .partner-org-name {
      font-size: 0.8rem;
    }
  }
</style>

