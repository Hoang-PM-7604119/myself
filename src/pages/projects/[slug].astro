---
import { render, type CollectionEntry } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import { published, pretty, wordsToMinutes } from '@/lib/content';
export async function getStaticPaths(){return (await published('projects')).map((entry)=>({params:{slug:entry.id},props:{entry}}))}
const { entry }=Astro.props as {entry:CollectionEntry<'projects'>}; const {Content,headings,remarkPluginFrontmatter}=await render(entry); const all=await published('projects'); const people=await published('people'); const pubs=await published('publications'); const idx=all.findIndex(p=>p.id===entry.id); const previous=all[idx-1],next=all[idx+1]; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
const prose=remarkPluginFrontmatter?.minutes?String(remarkPluginFrontmatter.minutes):entry.body??''; const ld={'@context':'https://schema.org','@type':'CreativeWork',name:entry.data.title,description:entry.data.description,dateCreated:entry.data.date.toISOString()};
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.cover} article={ld} progress><article class="content-shell"><header class="article-head"><p class="eyebrow">Project story · {pretty(entry.data.status)}</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p><img class="project-cover" src={asset(entry.data.cover)} width="1200" height="720" alt=""/><dl class="project-meta"><div><dt>Timeline</dt><dd>{entry.data.start}—{entry.data.end??'present'}</dd></div><div><dt>Reading time</dt><dd>{wordsToMinutes(prose)} min</dd></div><div><dt>Partners</dt><dd>{entry.data.organizations.length}</dd></div><div><dt>Collaborators</dt><dd>{entry.data.people.length}</dd></div><div><dt>Technologies</dt><dd>{entry.data.technologies.length}</dd></div></dl><div class="tags">{entry.data.topics.map(t=><a href={asset(`/topics/${t}/`)}>{pretty(t)}</a>)}</div></header><div class="article-grid"><aside class="toc"><strong>On this page</strong><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol><div class="resource-links">{entry.data.code&&<a href={entry.data.code}>Code ↗</a>}{entry.data.dataset&&<a href={entry.data.dataset}>Dataset ↗</a>}{entry.data.video&&<a href={entry.data.video} target="_blank" rel="noopener">Video ↗</a>}</div></aside><div class="prose"><Content/>{entry.data.organizations.length > 0 && <h2>Partners & Research Institutions</h2><ul>{entry.data.organizations.map(org => <li><strong>{org}</strong></li>)}</ul>}<h2>People involved</h2><div class="people-grid">{people.filter(p=>entry.data.people.includes(p.id)).map(p=><article class="person"><img src={asset(p.data.image)} width="400" height="400" alt=""/><div><h3><a href={asset(`/people/${p.id}/`)}>{p.data.title}</a></h3><small>{p.data.role}</small></div></article>)}</div><h2>Related publications</h2>{pubs.filter(p=>entry.data.publications.includes(p.id)||p.data.projects.includes(entry.id)).map(p=><p><a href={asset(`/publications/${p.id}/`)}>{p.data.title}</a></p>)}<nav class="pagination">{previous?<a href={asset(`/projects/${previous.id}/`)}>← {previous.data.title}</a>:<span/>}{next&&<a href={asset(`/projects/${next.id}/`)}>{next.data.title} →</a>}</nav></div></div></article></BaseLayout>
