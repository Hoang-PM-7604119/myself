---
import { render, type CollectionEntry } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import { published, pretty, wordsToMinutes } from '@/lib/content';
export async function getStaticPaths(){return (await published('projects')).map((entry)=>({params:{slug:entry.id},props:{entry}}))}
const { entry }=Astro.props as {entry:CollectionEntry<'projects'>}; const {Content,headings,remarkPluginFrontmatter}=await render(entry); const all=await published('projects'); const people=await published('people'); const pubs=await published('publications'); const idx=all.findIndex(p=>p.id===entry.id); const previous=all[idx-1],next=all[idx+1]; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
const prose=remarkPluginFrontmatter?.minutes?String(remarkPluginFrontmatter.minutes):entry.body??''; const ld={'@context':'https://schema.org','@type':'CreativeWork',name:entry.data.title,description:entry.data.description,dateCreated:entry.data.date.toISOString()};
const rawH2 = Array.from((entry.body || '').matchAll(/^##\s+(.+)$/gm)).map(m => m[1]);
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.cover} article={ld} progress><article class="content-shell"><header class="article-head"><p class="eyebrow"><span data-i18n-en>Project story · {pretty(entry.data.status)}</span><span data-i18n-vi>Hồ sơ dự án · {entry.data.status === 'active' ? 'Đang thực hiện' : (entry.data.status === 'completed' ? 'Hoàn thành' : 'Tạm dừng')}</span></p><h1><span data-i18n-en>{entry.data.title}</span><span data-i18n-vi>{entry.data.title_vi || entry.data.title}</span></h1><p class="lede"><span data-i18n-en>{entry.data.description}</span><span data-i18n-vi>{entry.data.description_vi || entry.data.description}</span></p><img class="project-cover" src={asset(entry.data.cover)} width="1200" height="720" alt=""/><dl class="project-meta"><div><dt><span data-i18n-en>Timeline</span><span data-i18n-vi>Thời gian</span></dt><dd>{entry.data.start}—{entry.data.end ?? <><span data-i18n-en>present</span><span data-i18n-vi>hiện tại</span></>}</dd></div><div><dt><span data-i18n-en>Reading time</span><span data-i18n-vi>Thời lượng</span></dt><dd>{wordsToMinutes(prose)} <span data-i18n-en>min</span><span data-i18n-vi>phút</span></dd></div><div><dt><span data-i18n-en>Partners</span><span data-i18n-vi>Đối tác</span></dt><dd>{entry.data.organizations.length}</dd></div><div><dt><span data-i18n-en>Collaborators</span><span data-i18n-vi>Thành viên</span></dt><dd>{entry.data.people.length}</dd></div><div><dt><span data-i18n-en>Technologies</span><span data-i18n-vi>Công nghệ</span></dt><dd>{entry.data.technologies.length}</dd></div></dl><div class="tags">{entry.data.topics.map(t=><a href={asset(`/topics/${t}/`)}>{pretty(t)}</a>)}</div></header><div class="article-grid"><aside class="toc"><strong><span data-i18n-en>On this page</span><span data-i18n-vi>Mục lục trang</span></strong><ol>{headings.filter(h=>h.depth===2).map((h, idx)=><li><a href={`#${h.slug}`} set:html={rawH2[idx] || h.text} /></li>)}</ol><div class="resource-links">{entry.data.code&&<a href={entry.data.code}>Code ↗</a>}{entry.data.dataset&&<a href={entry.data.dataset}>Dataset ↗</a>}{entry.data.video&&<a href={entry.data.video} target="_blank" rel="noopener">Video ↗</a>}</div></aside><div class="prose"><Content/>{entry.data.organizations.length > 0 && <h2><span data-i18n-en>Partners & Research Institutions</span><span data-i18n-vi>Đối tác & Viện nghiên cứu</span></h2><ul>{entry.data.organizations.map(org => <li><strong>{org}</strong></li>)}</ul>}<h2><span data-i18n-en>People involved</span><span data-i18n-vi>Thành viên tham gia</span></h2><div class="people-grid">{people.filter(p=>entry.data.people.includes(p.id)).map(p=><article class="person"><img src={asset(p.data.image)} width="400" height="400" alt=""/><div><h3><a href={asset(`/people/${p.id}/`)}>{p.data.title}</a></h3><small>{p.data.role_vi ? <><span data-i18n-en>{p.data.role}</span><span data-i18n-vi>{p.data.role_vi}</span></> : p.data.role}</small></div></article>)}</div><h2><span data-i18n-en>Related publications</span><span data-i18n-vi>Công bố khoa học liên quan</span></h2>{pubs.filter(p=>entry.data.publications.includes(p.id)||p.data.projects.includes(entry.id)).map(p=><p><a href={asset(`/publications/${p.id}/`)}><span data-i18n-en>{p.data.title}</span><span data-i18n-vi>{p.data.title_vi || p.data.title}</span></a></p>)}<nav class="pagination">{previous?<a href={asset(`/projects/${previous.id}/`)}>← <span data-i18n-en>{previous.data.title}</span><span data-i18n-vi>{previous.data.title_vi || previous.data.title}</span></a>:<span/>}{next&&<a href={asset(`/projects/${next.id}/`)}><span data-i18n-en>{next.data.title}</span><span data-i18n-vi>{next.data.title_vi || next.data.title}</span> →</a>}</nav></div></div></article></BaseLayout>

