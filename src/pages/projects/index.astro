---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { published, pretty } from '@/lib/content'; const projects=await published('projects'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="Projects" description="Research project stories, including methods, setbacks, collaborators, lessons, and outcomes."><div class="page"><p class="eyebrow"><span data-i18n-en>Project archive</span><span data-i18n-vi>Kho lưu trữ dự án</span></p><h1><span data-i18n-en>The work behind the outcome.</span><span data-i18n-vi>Hành trình thực tế đằng sau mỗi kết quả.</span></h1><p class="lede"><span data-i18n-en>Projects are presented as evolving investigations—not polished result lists. Open one to see the questions, experiments, failed attempts, and people involved.</span><span data-i18n-vi>Mỗi dự án là một tiến trình nghiên cứu và thử nghiệm thực địa liên tục — từ đặt vấn đề, thiết kế kiến trúc đến các thử nghiệm thực địa và đội ngũ đồng hành.</span></p><div class="cards" style="margin-top:50px">{projects.map(p=><article class="card"><a href={asset(`/projects/${p.id}/`)}><img src={asset(p.data.cover)} width="1200" height="720" alt=""/></a><div class="card-body"><p class="eyebrow"><span data-i18n-en>{pretty(p.data.status)}</span><span data-i18n-vi>{p.data.status === 'active' ? 'Đang thực hiện' : (p.data.status === 'completed' ? 'Hoàn thành' : 'Tạm dừng')}</span> · {p.data.start}—{p.data.end ?? <><span data-i18n-en>present</span><span data-i18n-vi>hiện tại</span></>}</p><h3><a href={asset(`/projects/${p.id}/`)}><span data-i18n-en>{p.data.title}</span><span data-i18n-vi>{p.data.title_vi || p.data.title}</span></a></h3><p><span data-i18n-en>{p.data.description}</span><span data-i18n-vi>{p.data.description_vi || p.data.description}</span></p></div></article>)}</div></div></BaseLayout>

