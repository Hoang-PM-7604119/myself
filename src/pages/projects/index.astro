---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { published, pretty } from '@/lib/content'; const projects=await published('projects'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="Projects" description="Research project stories, including methods, setbacks, collaborators, lessons, and outcomes."><div class="page"><p class="eyebrow">Project archive</p><h1>The work behind the outcome.</h1><p class="lede">Projects are presented as evolving investigations—not polished result lists. Open one to see the questions, experiments, failed attempts, and people involved.</p><div class="cards" style="margin-top:50px">{projects.map(p=><article class="card"><a href={asset(`/projects/${p.id}/`)}><img src={asset(p.data.cover)} width="1200" height="720" alt=""/></a><div class="card-body"><p class="eyebrow">{pretty(p.data.status)} · {p.data.start}—{p.data.end??'present'}</p><h3><a href={asset(`/projects/${p.id}/`)}>{p.data.title}</a></h3><p>{p.data.description}</p></div></article>)}</div></div></BaseLayout>
