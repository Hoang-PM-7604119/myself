---
import BaseLayout from '@/layouts/BaseLayout.astro'; import profile from '@/data/profile.yaml'; import experience from '@/data/experience.yaml'; import education from '@/data/education.yaml'; import awards from '@/data/awards.yaml'; import { published } from '@/lib/content'; const pubs=await published('publications'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="CV" description={`Academic CV for ${profile.name}.`}><div class="page"><p class="eyebrow"><span data-i18n-en>Curriculum vitae</span><span data-i18n-vi>Lý lịch khoa học</span></p><h1>{profile.name}</h1><p class="lede">{profile.role}, {profile.institution}</p><div class="actions"><a class="button primary" href={`mailto:${profile.email}`}>{profile.email}</a><a class="button" href={asset('/projects/')}><span data-i18n-en>Research systems</span><span data-i18n-vi>Hệ thống nghiên cứu</span></a></div><section><div class="section-head"><h2><span data-i18n-en>Appointments & Experience</span><span data-i18n-vi>Quá trình công tác</span></h2></div>{experience.map(e=><article><h3>{e.role}, {e.organization}</h3><p>{e.start} - {e.present?'present':e.end} / {e.location}</p></article>)}</section><section><div class="section-head"><h2><span data-i18n-en>Education</span><span data-i18n-vi>Học vấn</span></h2></div>{education.map(e=><article><h3>{e.degree}, {e.institution}</h3><p>{e.start} - {e.end}</p></article>)}</section><section><div class="section-head"><h2><span data-i18n-en>Selected publications</span><span data-i18n-vi>Công bố khoa học tiêu biểu</span></h2></div>{pubs.map(p=><p>{p.data.authors.map(a=>a.name).join(', ')}. "<a href={asset(`/publications/${p.id}/`)}>{p.data.title}</a>." {p.data.venue}, {p.data.year}.</p>)}</section><section><div class="section-head"><h2><span data-i18n-en>Funding and honors</span><span data-i18n-vi>Tài trợ & Giải thưởng</span></h2></div>{awards.map(a=><p>{a.year}. <strong>{a.title}</strong>, {a.issuer}.</p>)}</section></div></BaseLayout>
