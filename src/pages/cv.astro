---
import BaseLayout from '@/layouts/BaseLayout.astro'; import profile from '@/data/profile.yaml'; import experience from '@/data/experience.yaml'; import education from '@/data/education.yaml'; import awards from '@/data/awards.yaml'; import { published } from '@/lib/content'; const pubs=await published('publications'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="CV" description={`Academic CV for ${profile.name}.`}><div class="page"><p class="eyebrow"><span data-i18n-en>Curriculum vitae</span><span data-i18n-vi>Lý lịch khoa học</span></p><h1>{profile.name}</h1><p class="lede"><span data-i18n-en>{profile.role}, {profile.institution}</span><span data-i18n-vi>{profile.role_vi || profile.role}, {profile.institution_vi || profile.institution}</span></p><div class="actions"><a class="button primary" href={`mailto:${profile.email}`}>{profile.email}</a><a class="button" href={asset('/projects/')}><span data-i18n-en>Research systems</span><span data-i18n-vi>Hệ thống nghiên cứu</span></a></div><section><div class="section-head"><h2><span data-i18n-en>Appointments & Experience</span><span data-i18n-vi>Quá trình công tác</span></h2></div>{experience.map(e=><article><h3><span data-i18n-en>{e.role}, {e.organization}</span><span data-i18n-vi>{e.role_vi || e.role}, {e.organization_vi || e.organization}</span></h3><p>{e.start} - {e.present ? <><span data-i18n-en>present</span><span data-i18n-vi>hiện tại</span></> : e.end} / <span data-i18n-en>{e.location}</span><span data-i18n-vi>{e.location === 'Hanoi, Vietnam' ? 'Hà Nội, Việt Nam' : e.location}</span></p></article>)}</section><section><div class="section-head"><h2><span data-i18n-en>Education</span><span data-i18n-vi>Học vấn</span></h2></div>{education.map(e=><article><h3><span data-i18n-en>{e.degree}, {e.institution}</span><span data-i18n-vi>{e.degree_vi || e.degree}, {e.institution_vi || e.institution}</span></h3><p>{e.start} - {e.end}</p></article>)}</section><section><div class="section-head"><h2><span data-i18n-en>Selected publications</span><span data-i18n-vi>Công bố khoa học tiêu biểu</span></h2></div>{pubs.map(p=><p>{p.data.authors.map(a=>a.name).join(', ')}. "<a href={asset(`/publications/${p.id}/`)}><span data-i18n-en>{p.data.title}</span><span data-i18n-vi>{p.data.title_vi || p.data.title}</span></a>." {p.data.venue}, {p.data.year}.</p>)}</section><section><div class="section-head"><h2><span data-i18n-en>Funding and honors</span><span data-i18n-vi>Tài trợ & Giải thưởng</span></h2></div>{awards.map(a=><p>{a.year}. <strong><span data-i18n-en>{a.title}</span><span data-i18n-vi>{a.title_vi || a.title}</span></strong>, <span data-i18n-en>{a.issuer}</span><span data-i18n-vi>{a.issuer_vi || a.issuer}</span>.</p>)}</section></div></BaseLayout>
