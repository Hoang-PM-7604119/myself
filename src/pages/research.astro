---
import BaseLayout from '@/layouts/BaseLayout.astro'; import research from '@/data/research.yaml'; import { published } from '@/lib/content'; const projects=await published('projects'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="Research" description="Research themes connecting edge intelligence, architecture, dependability, privacy, and security."><div class="page"><p class="eyebrow">Research agenda</p><h1>Systems shaped by constraints—and by people.</h1><p class="lede">Four themes connect the lab’s work. Each is a lens, not a silo: the most useful projects cross several at once.</p>{research.map((r,i)=><section id={r.slug}><div class="section-head"><div><p class="eyebrow">Theme 0{i+1}</p><h2>{r.title}</h2></div><p>{r.summary}</p></div><div class="cards">{projects.filter(p=>p.data.topics.includes(r.slug)).map(p=><article class="card"><img src={asset(p.data.cover)} width="1200" height="720" loading="lazy" alt=""/><div class="card-body"><h3><a href={asset(`/projects/${p.id}/`)}>{p.data.title}</a></h3><p>{p.data.description}</p></div></article>)}</div></section>)}</div></BaseLayout>
