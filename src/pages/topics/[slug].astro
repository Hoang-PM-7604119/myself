---
import BaseLayout from '@/layouts/BaseLayout.astro'; import research from '@/data/research.yaml'; import { published } from '@/lib/content';
export function getStaticPaths(){return research.map(topic=>({params:{slug:topic.slug},props:{topic}}))}
const {topic}=Astro.props as {topic:{slug:string;title:string;title_vi?:string;summary:string;summary_vi?:string}}; const projects=(await published('projects')).filter(p=>p.data.topics.includes(topic.slug)); const pubs=(await published('publications')).filter(p=>p.data.topics.includes(topic.slug)); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title={topic.title} description={topic.summary}><div class="page"><p class="eyebrow"><span data-i18n-en>Research topic</span><span data-i18n-vi>Chủ đề nghiên cứu</span></p><h1><span data-i18n-en>{topic.title}</span><span data-i18n-vi>{topic.title_vi || topic.title}</span></h1><p class="lede"><span data-i18n-en>{topic.summary}</span><span data-i18n-vi>{topic.summary_vi || topic.summary}</span></p><section><div class="section-head"><h2><span data-i18n-en>Connected projects</span><span data-i18n-vi>Dự án liên quan</span></h2></div><div class="cards">{projects.map(p=><article class="card"><img src={asset(p.data.cover)} width="1200" height="720" alt=""/><div class="card-body"><h3><a href={asset(`/projects/${p.id}/`)}><span data-i18n-en>{p.data.title}</span><span data-i18n-vi>{p.data.title_vi || p.data.title}</span></a></h3><p><span data-i18n-en>{p.data.description}</span><span data-i18n-vi>{p.data.description_vi || p.data.description}</span></p></div></article>)}</div></section><section><div class="section-head"><h2><span data-i18n-en>Publications</span><span data-i18n-vi>Công bố khoa học</span></h2></div>{pubs.map(p=><article class="publication"><div class="year">{p.data.year}</div><div><h3><a href={asset(`/publications/${p.id}/`)}><span data-i18n-en>{p.data.title}</span><span data-i18n-vi>{p.data.title_vi || p.data.title}</span></a></h3><p><span data-i18n-en>{p.data.summary}</span><span data-i18n-vi>{p.data.summary_vi || p.data.summary}</span></p></div></article>)}</section></div></BaseLayout>

