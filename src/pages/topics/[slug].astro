---
import BaseLayout from '@/layouts/BaseLayout.astro'; import research from '@/data/research.yaml'; import { published } from '@/lib/content';
export function getStaticPaths(){return research.map(topic=>({params:{slug:topic.slug},props:{topic}}))}
const {topic}=Astro.props as {topic:{slug:string;title:string;summary:string}}; const projects=(await published('projects')).filter(p=>p.data.topics.includes(topic.slug)); const pubs=(await published('publications')).filter(p=>p.data.topics.includes(topic.slug)); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title={topic.title} description={topic.summary}><div class="page"><p class="eyebrow">Research topic</p><h1>{topic.title}</h1><p class="lede">{topic.summary}</p><section><div class="section-head"><h2>Connected projects</h2></div><div class="cards">{projects.map(p=><article class="card"><img src={asset(p.data.cover)} width="1200" height="720" alt=""/><div class="card-body"><h3><a href={asset(`/projects/${p.id}/`)}>{p.data.title}</a></h3><p>{p.data.description}</p></div></article>)}</div></section><section><div class="section-head"><h2>Publications</h2></div>{pubs.map(p=><article class="publication"><div class="year">{p.data.year}</div><div><h3><a href={asset(`/publications/${p.id}/`)}>{p.data.title}</a></h3><p>{p.data.summary}</p></div></article>)}</section></div></BaseLayout>
