---
import BaseLayout from '@/layouts/BaseLayout.astro'; import education from '@/data/education.yaml'; import awards from '@/data/awards.yaml';
---
<BaseLayout title="Education" description="Education, doctoral training, and academic awards."><div class="page"><p class="eyebrow"><span data-i18n-en>Education</span><span data-i18n-vi>Quá trình đào tạo</span></p><h1><span data-i18n-en>Training and foundations.</span><span data-i18n-vi>Nền tảng học thuật và đào tạo.</span></h1><div class="timeline" style="margin-top:50px">{education.map(e=><article class="timeline-item"><span class="date">{e.start}—{e.end} · {e.location}</span><h2>{e.degree}</h2><strong>{e.institution}</strong>{e.thesis&&<p><span data-i18n-en>Thesis:</span><span data-i18n-vi>Khóa luận:</span> <em>{e.thesis}</em></p>}{e.advisor&&<p><span data-i18n-en>Advisor:</span><span data-i18n-vi>Người hướng dẫn:</span> {e.advisor}</p>}{e.note&&<p>{e.note}</p>}</article>)}</div><section><div class="section-head"><h2><span data-i18n-en>Awards</span><span data-i18n-vi>Giải thưởng & Vinh danh</span></h2></div><div class="cards">{awards.map(a=><article class="callout"><p class="eyebrow">{a.year} · {a.issuer}</p><h3>{a.title}</h3><p>{a.description}</p></article>)}</div></section></div></BaseLayout>
