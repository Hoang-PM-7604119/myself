---
import BaseLayout from '@/layouts/BaseLayout.astro'; import education from '@/data/education.yaml'; import awards from '@/data/awards.yaml';
---
<BaseLayout title="Education" description="Education, doctoral training, and academic awards."><div class="page"><p class="eyebrow"><span data-i18n-en>Education</span><span data-i18n-vi>Quá trình đào tạo</span></p><h1><span data-i18n-en>Training and foundations.</span><span data-i18n-vi>Nền tảng học thuật và đào tạo.</span></h1><div class="timeline" style="margin-top:50px">{education.map(e=><article class="timeline-item"><span class="date">{e.start}—{e.end} · <span data-i18n-en>{e.location}</span><span data-i18n-vi>{e.location === 'Hanoi, Vietnam' ? 'Hà Nội, Việt Nam' : e.location}</span></span><h2><span data-i18n-en>{e.degree}</span><span data-i18n-vi>{e.degree_vi || e.degree}</span></h2><strong><span data-i18n-en>{e.institution}</span><span data-i18n-vi>{e.institution_vi || e.institution}</span></strong>{e.thesis&&<p><span data-i18n-en>Thesis:</span><span data-i18n-vi>Khóa luận:</span> <em>{e.thesis}</em></p>}{e.advisor&&<p><span data-i18n-en>Advisor:</span><span data-i18n-vi>Người hướng dẫn:</span> {e.advisor}</p>}{e.note&&<p><span data-i18n-en>{e.note}</span><span data-i18n-vi>{e.note_vi || e.note}</span></p>}</article>)}</div><section><div class="section-head"><h2><span data-i18n-en>Awards</span><span data-i18n-vi>Giải thưởng & Vinh danh</span></h2></div><div class="cards">{awards.map(a=><article class="callout"><p class="eyebrow">{a.year} · <span data-i18n-en>{a.issuer}</span><span data-i18n-vi>{a.issuer_vi || a.issuer}</span></p><h3><span data-i18n-en>{a.title}</span><span data-i18n-vi>{a.title_vi || a.title}</span></h3><p><span data-i18n-en>{a.description}</span><span data-i18n-vi>{a.description_vi || a.description}</span></p></article>)}</div></section></div></BaseLayout>
