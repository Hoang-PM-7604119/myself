---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { published, pretty } from '@/lib/content'; const pubs=await published('publications'); const years=[...new Set(pubs.map(p=>p.data.year))].sort((a,b)=>b-a); const types=[...new Set(pubs.map(p=>p.data.type))]; const topics=[...new Set(pubs.flatMap(p=>p.data.topics))]; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="Publications" description="Publications with plain-language summaries, contributions, artifacts, and connected research stories."><div class="page"><p class="eyebrow"><span data-i18n-en>Publication record</span><span data-i18n-vi>Hồ sơ công bố khoa học</span></p><h1><span data-i18n-en>Papers are milestones, not the whole map.</span><span data-i18n-vi>Mỗi bài báo là một cột mốc trong tiến trình nghiên cứu.</span></h1><p class="lede"><span data-i18n-en>Every entry includes a plain-language account and links back to the project and people that shaped it. Filters enhance the complete server-rendered list.</span><span data-i18n-vi>Mỗi công bố đi kèm tóm tắt khoa học đại chúng và kết nối trực tiếp với dự án cũng như cộng sự tham gia. Bộ lọc hỗ trợ tra cứu nhanh toàn bộ danh mục.</span></p><div class="filters" aria-label="Publication filters"><input id="pub-search" type="search" placeholder="Search title, author, or venue" aria-label="Search publications"/><select id="pub-year" aria-label="Filter by year"><option value="">All years</option>{years.map(y=><option>{y}</option>)}</select><select id="pub-type" aria-label="Filter by type"><option value="">All types</option>{types.map(t=><option value={t}>{pretty(t)}</option>)}</select><select id="pub-topic" aria-label="Filter by topic"><option value="">All topics</option>{topics.map(t=><option value={t}>{pretty(t)}</option>)}</select></div><div class="publication-list" id="pub-list">{pubs.map(p=><article class="publication" data-year={p.data.year} data-type={p.data.type} data-topics={p.data.topics.join(' ')} data-search={`${p.data.title} ${p.data.venue} ${p.data.authors.map(a=>a.name).join(' ')}`.toLowerCase()}><div class="year">{p.data.year}<br/><span class="tag">{pretty(p.data.status)}</span></div><div><h2><a class="publication-title" href={asset(`/publications/${p.id}/`)}>{p.data.title}</a></h2><p class="authors">{p.data.authors.map(a=><span>{a.highlight?<strong>{a.name}</strong>:a.name}{a.first&&<span class="badge">FIRST</span>}{a.corresponding&&<span class="badge">CORRESP.</span>}, </span>)}</p><p>{p.data.summary}</p><p class="eyebrow">{p.data.venue} · {pretty(p.data.type)}</p></div></article>)}</div><p class="empty" id="pub-empty"><span data-i18n-en>No publications match these filters.</span><span data-i18n-vi>Không tìm thấy công bố phù hợp với bộ lọc này.</span></p></div><script>const controls=['pub-search','pub-year','pub-type','pub-topic'].map(id=>document.getElementById(id) as HTMLInputElement|HTMLSelectElement);const update=()=>{const [q,y,t,topic]=controls.map(c=>c.value.toLowerCase());let shown=0;document.querySelectorAll<HTMLElement>('#pub-list article').forEach(el=>{const yes=(!q||el.dataset.search?.includes(q))&&(!y||el.dataset.year===y)&&(!t||el.dataset.type===t)&&(!topic||el.dataset.topics?.split(' ').includes(topic));el.hidden=!yes;if(yes)shown++});const empty=document.getElementById('pub-empty');if(empty)empty.style.display=shown?'none':'block'};controls.forEach(c=>c.addEventListener('input',update));</script></BaseLayout>
