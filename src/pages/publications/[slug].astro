---
import { render, type CollectionEntry } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import { published, pretty } from '@/lib/content';
export async function getStaticPaths(){return (await published('publications')).map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props as {entry:CollectionEntry<'publications'>}; const {Content}=await render(entry); const projects=await published('projects'); const people=await published('people'); const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`; const ld={'@context':'https://schema.org','@type':'ScholarlyArticle',headline:entry.data.title,description:entry.data.abstract,datePublished:entry.data.date.toISOString(),author:entry.data.authors.map(a=>({'@type':'Person',name:a.name})),isPartOf:{'@type':'Periodical',name:entry.data.venue}};
---
<BaseLayout title={entry.data.title} description={entry.data.description} article={ld} progress><article class="content-shell"><header class="article-head"><p class="eyebrow">{pretty(entry.data.type)} · {entry.data.year} · {pretty(entry.data.status)}</p><h1>{entry.data.title}</h1><p class="lede">{entry.data.summary}</p><p class="authors">{entry.data.authors.map(a=><span>{a.highlight?<strong>{a.name}</strong>:a.name}{a.first&&<span class="badge">FIRST AUTHOR</span>}{a.corresponding&&<span class="badge">CORRESPONDING</span>}, </span>)}</p><p><strong>{entry.data.venue}</strong></p><div class="resource-links">{entry.data.doi&&<a class="button" href={entry.data.doi}>DOI</a>}{entry.data.paper&&<a class="button" href={entry.data.paper}>Paper</a>}{entry.data.pdf&&<a class="button" href={asset(entry.data.pdf)}>PDF</a>}{entry.data.code&&<a class="button" href={entry.data.code}>Code</a>}{entry.data.dataset&&<a class="button" href={entry.data.dataset}>Dataset</a>}</div></header><div class="article-grid"><aside class="toc"><strong><span data-i18n-en>Publication details</span><span data-i18n-vi>Chi tiết công bố</span></strong><p>{entry.data.year}<br/>{pretty(entry.data.type)}<br/>{pretty(entry.data.status)}</p></aside><div class="prose"><h2><span data-i18n-en>Abstract</span><span data-i18n-vi>Tóm tắt khoa học (Abstract)</span></h2><p>{entry.data.abstract}</p><h2><span data-i18n-en>Plain-language summary</span><span data-i18n-vi>Tóm tắt đại chúng</span></h2><p>{entry.data.summary}</p>{entry.data.contribution&&<><h2><span data-i18n-en>Personal contribution</span><span data-i18n-vi>Đóng góp cá nhân</span></h2><p>{entry.data.contribution}</p></>}<Content/><h2><span data-i18n-en>Research connections</span><span data-i18n-vi>Kết nối nghiên cứu</span></h2>{projects.filter(p=>entry.data.projects.includes(p.id)).map(p=><p><a href={asset(`/projects/${p.id}/`)}>{p.data.title}</a> — {p.data.description}</p>)}{people.filter(p=>entry.data.authors.some(a=>a.person===p.id)).map(p=><p><a href={asset(`/people/${p.id}/`)}>{p.data.title}</a>, {p.data.organization}</p>)}<details class="accordion"><summary><span data-i18n-en>BibTeX citation</span><span data-i18n-vi>Trích dẫn BibTeX</span></summary><pre>{entry.data.bibtex}</pre><button class="copy" data-copy={entry.data.bibtex}><span data-i18n-en>Copy BibTeX</span><span data-i18n-vi>Sao chép BibTeX</span></button></details></div></div></article></BaseLayout>
