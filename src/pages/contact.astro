---
import BaseLayout from '@/layouts/BaseLayout.astro'; import profile from '@/data/profile.yaml'; import social from '@/data/social.yaml';
---
<BaseLayout title="Contact" description={`Contact ${profile.name} about research, collaboration, or AIoT systems.`}><div class="page"><p class="eyebrow">Contact</p><h1>Let us compare notes.</h1><div class="contact-grid" style="margin-top:50px"><div><p class="lede">For research collaborations, technical questions, or AIoT platform discussions, email is best.</p><p><a href={`mailto:${profile.email}`}>{profile.email}</a> <button class="copy" data-copy={profile.email}>Copy email</button></p><p>{profile.institution}<br/>{profile.location}</p><div class="socials"><a href={social.github}>GitHub</a><a href={social.linkedin}>LinkedIn</a><a href={social.scholar}>Google Scholar</a></div><p class="notice">This form never sends data to a service. It prepares a message in your own email application.</p></div><form class="contact-form" id="contact-form"><label>Your name<input name="name" autocomplete="name" required/></label><label>Subject<input name="subject" required/></label><label>Message<textarea name="message" rows="8" required></textarea></label><button class="button primary" type="submit">Open email draft</button></form></div></div><script is:inline define:vars={{email:profile.email}}>document.getElementById('contact-form')?.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget;if(!(form instanceof HTMLFormElement))return;const data=new FormData(form);location.href=`mailto:${email}?subject=${encodeURIComponent(String(data.get('subject')))}&body=${encodeURIComponent(`Hello, I am ${data.get('name')}.\n\n${data.get('message')}`)}`});</script></BaseLayout>
