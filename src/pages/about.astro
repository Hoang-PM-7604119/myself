---
import BaseLayout from '@/layouts/BaseLayout.astro'; import profile from '@/data/profile.yaml'; import awards from '@/data/awards.yaml'; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="About" description={`About ${profile.name} and his approach to research engineering.`}><div class="page"><p class="eyebrow"><span data-i18n-en>About</span><span data-i18n-vi>Giới thiệu</span></p><h1><span data-i18n-en>Engineering with the whole system in view.</span><span data-i18n-vi>Kỹ thuật hệ thống toàn diện.</span></h1><div class="contact-grid"><div><p class="lede"><span data-i18n-en>{profile.bio}</span><span data-i18n-vi>Minh-Hoàng Phạm là Trợ lý nghiên cứu và Trưởng nhóm kỹ thuật làm việc trong các lĩnh vực AIoT, giám sát môi trường, thị giác máy tính, AI biên, hệ thống nhúng và hạ tầng đám mây. Anh dẫn dắt các nhóm sinh viên và trợ lý nghiên cứu phát triển các nền tảng cảm biến thực địa phục vụ bảo tồn đa dạng sinh học, nuôi trồng thủy sản thông minh, giám sát rừng ngập mặn và giám sát đàn ong.</span></p><p><span data-i18n-en>I am interested in systems that live close to physical processes: sensors, embedded controllers, computer-vision modules, backend services, and small learning systems that need to keep working after they leave the lab.</span><span data-i18n-vi>Tôi tập trung nghiên cứu các hệ thống gắn liền với quá trình vật lý thực tế: cảm biến, bộ điều khiển nhúng, thị giác máy tính, dịch vụ backend và mô hình học máy duy trì hoạt động ổn định ngoài phòng thí nghiệm.</span></p><a class="button primary" href={asset('/cv/')}><span data-i18n-en>View academic CV</span><span data-i18n-vi>Xem lý lịch khoa học</span></a></div><img src={asset(profile.image)} width="720" height="840" alt={`System profile graphic for ${profile.name}`} style="border-radius:var(--radius)" /></div><section><div class="section-head"><h2><span data-i18n-en>Funding and honors</span><span data-i18n-vi>Tài trợ & Giải thưởng</span></h2></div><div class="cards">{awards.map(a=><article class="callout"><p class="eyebrow">{a.year} / {a.issuer}</p><h3>{a.title}</h3><p>{a.description}</p></article>)}</div></section></div></BaseLayout>
