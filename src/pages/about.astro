---
import BaseLayout from '@/layouts/BaseLayout.astro'; import profile from '@/data/profile.yaml'; import awards from '@/data/awards.yaml'; const asset=(p:string)=>`${import.meta.env.BASE_URL}${p.replace(/^\//,'')}`;
---
<BaseLayout title="About" description={`About ${profile.name} and her approach to research.`}><div class="page"><p class="eyebrow">About</p><h1>Engineering with the whole system in view.</h1><div class="contact-grid"><div><p class="lede">{profile.bio}</p><p>I am interested in computers that live close to physical processes: sensors, embedded controllers, and small learning systems. My group studies what happens when these devices have limited power, incomplete data, uncertain networks, and meaningful privacy obligations.</p><p class="notice"><strong>Fictional example:</strong> Names, organizations, accomplishments, and contact details on this starter site are placeholders designed to be replaced through YAML and Markdown.</p><a class="button primary" href={asset('/cv/')}>View academic CV</a></div><img src={asset(profile.image)} width="720" height="840" alt={`Fictional portrait of ${profile.name}`} style="border-radius:var(--radius)" /></div><section><div class="section-head"><h2>Awards</h2></div><div class="cards">{awards.map(a=><article class="callout"><p class="eyebrow">{a.year} · {a.issuer}</p><h3>{a.title}</h3><p>{a.description}</p></article>)}</div></section></div></BaseLayout>
